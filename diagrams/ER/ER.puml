@startuml 
title ER диаграмма

package "БД устройств" {
    ' Сущности
    entity "Устройство" as Device {
        * id : uuid <<PK>>
        --
        * device_type_id : uuid <<FK>>
        * location_id : uuid <<FK>>
        --
        * name : varchar (50)
    }

    entity "Тип устройства" as DeviceType {
        * id : uuid <<PK>>
        --
        * owner_user_id : uuid
        --
        * name : varchar (50)
        * is_custom : bool
        * description : text
    }

    entity "Связь типа устройства и действий" as DeviceType_Capability {
        * id : uuid <<PK>>
        --
        * device_type_id : uuid <<FK>>
        * capability_id : uuid <<FK>>
    }

    entity "Тип действия" as Capability {
        * id : uuid <<PK>>
        --
        * owner_user_id : uuid  
        --
        * name : varchar (50)
        * is_custom : bool
        * required_user_role :  varchar (20)
        * required_action : varchar (7)
    }

    entity "Локация" as Location {
        * id : uuid <<PK>>
        --
        * home_id : uuid <<FK>>
        --
        * name : varchar (50)
    } 

    entity "Дом" as Home {
        * id : uuid <<PK>>
        --
        * owner_user_id : uuid
        --
        * name : varchar (50)
    }
    ' Связи
    Device }o--|| DeviceType : "имеет тип"
    DeviceType ||--|{ DeviceType_Capability : "поддерживает"
    DeviceType_Capability }o--|| Capability : "использует возможность"

    Device }o--|| Location : "расположено в"
    Location }o--|| Home : "принадлежит"
}

package "БД телеметрии" {
    ' Сущности
    entity "Телеметрия" as Telemetry {
        * id : uuid <<PK>>
        --
        * device_id : uuid
        --
        * metric : varchar (20)
        * time : timestamptz
        * event_id : uuid
        --
          value_int : int
          value_text : text
          unit : varchar (16)
    }
}

package "БД сценариев" {
    ' Сущности
    entity "Сценарий" as Scenario {
        * id : uuid <<PK>>
        --
        * owner_user_id : uuid
        --
        * name : varchar(50)
        * is_custom : bool
        * is_active : bool
        * definition : json
        --
          description : text
    }
}

package "БД пользователей" {
    ' Сущности
    entity "Пользователь" as User {
        * id : uuid <<PK>>
        --
        * name : VARCHAR(100)
        * email : varchar(254)
        * password_hash : varchar(255)
        --
          phone : varchar(16)
    }

    entity "Доступ к дому" as Membership {
        * id : uuid <<PK>>
        --
        * user_id : uuid <<FK>>
        --
        * home_id : uuid
        --
        * role : varchar (20)
    }

    ' entity "Связь пользователей и доступов к дому" as User_Membership {
    '     * id : uuid <<PK>>
    '     --
    '     * user_id : uuid <<FK>>
    '     * membership_id : uuid <<FK>>
    ' }

    entity "Группа пользователей" as UserGroup {
        * id : uuid <<PK>>
        --
        * owner_user_id : uuid <<FK>>
        --
        * name : varchar(50)
        --
          description : text
    }

    entity "Связь пользователей и группы пользователей" as User_UserGroup {
        * id : uuid <<PK>>
        --
        * user_id : uuid <<FK>>
        * user_group_id : uuid <<FK>>
    }

    entity "Разрешение" as Permission {
        * id : uuid <<PK>>
        --
        * user_group_id : uuid <<FK>>
        --
        * device_id : uuid
        --
        * action : varchar (7)
    }

    ' entity "Связь группы группы пользователей и разрешений" as UserGroup_Permission{
    '     * id : uuid <<PK>>
    '     --
    '     * user_group_id : uuid <<FK>>
    '     * permission_id : uuid <<FK>>
    ' }

    entity "Приглашение в группу пользователей" as UserGroupInvitation {
        * id : uuid <<PK>>
        --
        * owner_user_id : uuid <<FK>>
        * invited_user_id : uuid <<FK>>
        * user_group_id : uuid <<FK>>
        --
          message : text
    }

    entity "Предоставление доступа к дому" as HomeInvitation {
        * id : uuid <<PK>>
        --
        * owner_user_id : uuid <<FK>>
        * invited_user_id : uuid <<FK>>
        --
        * home_id : uuid
        * role : varchar(20)
        --
          message : text
    }
    ' Связи
    User ||--o{ Membership : "имеет доступ"

    User ||--o{ User_UserGroup : "состоит в"
    User_UserGroup }o--|| UserGroup : "входит в"
    User ||--o{ UserGroup : "создаёт"

    UserGroup ||--o{ Permission : "получает права"

    User ||--o{ UserGroupInvitation : "отправляет"
    User ||--o{ UserGroupInvitation : "получает"
    UserGroup ||--o{ UserGroupInvitation : "приглашение в группу"

    User ||--o{ HomeInvitation : "отправляет"
    User ||--o{ HomeInvitation : "получает"
}

package "БД уведомлений" {
    ' Сущности
    entity "Уведомление" as Notification {
        * id : uuid <<PK>>
        --
        * recipient_user_id : uuid
        --
        * title : varchar (50)
        * message : text
        * notification_type : varchar(50)
        * notification_severity : varchar(50)
        * time : timestamptz
    }

    entity "Правило уведомления" as NotificationRule {
        * id : uuid <<PK>>
        --
        * owner_user_id : uuid <<FK>>
        --
        * name : varchar(50)
        * is_custom : bool
        * is_active : bool
        * notification_type : varchar(50)
        * notification_severity : varchar(50)
        * delivery_channel : varchar(20)
    }

    entity "Доставка сообщения" as NotificationDelivery {
        * id : uuid <<PK>>
        --
        * notification_id : uuid <<FK>>
        * delivery_channel : varchar(20)
        * delivery_status : varchar(20)
        * time : timestamptz
        --
          failure_reason : text
    }
    ' Связи
    NotificationDelivery }|--|| Notification : "отвечает за"
}
' Связи между СУБД
Scenario }o..|| User : "создан пользователем"
Telemetry }o..|| Device : "измерена устройством"
Membership }|..|| Home : "доступ к дому"
DeviceType }o..|| User : "создан пользователем"
Permission }o..|| Device : "право на устройство"
HomeInvitation }o..|| Home : "приглашение в дом"
Notification }o..|| User : "предназначено пользователю"
NotificationRule }o..|| User : "настроено пользователем"
@enduml